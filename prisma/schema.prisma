generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CANCELED
}

enum OrderingSessionStatus {
  OPEN
  CLOSED
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
}

enum NotificationType {
  MENU_PUBLISHED
  ORDERING_OPEN
  ORDERING_DEADLINE
  POLL_CREATED
  POLL_CLOSED
  TIMETABLE_UPLOADED
  ADMIN_UPDATE
}

model User {
  id                   String     @id @default(cuid())
  fullName             String
  email                String     @unique
  passwordHash         String
  role                 Role       @default(STUDENT)
  status               UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt      DateTime?
  profileImageUrl      String?
  profileImagePublicId String?
  phone                String?
  bio                  String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
  votes               Vote[]
  notifications       Notification[]

  @@index([role, status])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Menu {
  id            String            @id @default(cuid())
  title         String
  description   String?
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  foodItems     FoodItem[]
  sessions      OrderingSession[]
}

model FoodItem {
  id            String   @id @default(cuid())
  menuId        String
  name          String
  details       String?
  category      String   @default("Food")
  price         Decimal  @db.Decimal(12, 2)
  imageUrl      String?
  imagePublicId String?
  isAvailable   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  menu       Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([menuId, isAvailable])
  @@index([category])
}

model OrderingSession {
  id        String                @id @default(cuid())
  menuId    String
  title     String
  status    OrderingSessionStatus @default(OPEN)
  summaryItems Json?
  summaryNotes String?
  deadline      DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  menu   Menu    @relation(fields: [menuId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([status, deadline])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  sessionId   String
  status      OrderStatus @default(DRAFT)
  submittedAt DateTime?
  canceledAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session OrderingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  items   OrderItem[]

  @@index([sessionId, status])
  @@index([userId, status])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  foodItemId String?
  itemName   String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, foodItemId])
  @@index([foodItemId])
}

model Poll {
  id                     String     @id @default(cuid())
  title                  String
  description            String?
  imageUrl               String?
  imagePublicId          String?
  status                 PollStatus @default(DRAFT)
  deadline               DateTime?
  allowVoteChange        Boolean    @default(false)
  showResultsBeforeClose Boolean    @default(false)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  options PollOption[]
  votes   Vote[]

  @@index([status, deadline])
}

model PollOption {
  id        String @id @default(cuid())
  pollId    String
  text      String
  sortOrder Int    @default(0)

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([pollId])
}

model Vote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
}

model CourseSchedule {
  id           String    @id @default(cuid())
  title        String
  description  String?
  weekStart    DateTime?
  weekEnd      DateTime?
  fileUrl      String
  filePublicId String?
  fileName     String
  fileType     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([weekStart, weekEnd])
}

model UploadedFile {
  id           String   @id @default(cuid())
  publicId     String   @unique
  url          String
  format       String?
  resourceType String
  purpose      String
  createdAt    DateTime @default(now())

  @@index([purpose])
}

model GroupSettings {
  id                String   @id @default("default")
  groupName         String   @default("Scholarship Community")
  latitude          Decimal? @db.Decimal(10, 7)
  longitude         Decimal? @db.Decimal(10, 7)
  locationLabel     String?
  currency          String   @default("EGP")
  googlePlaceRadius Int      @default(3000)
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
